<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoreApp.Views.SellerPage"
             Title="Seller Dashboard"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">
            <Label x:Name="StoreLabel" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="Your Product Listings" FontSize="18" TextColor="Gray" />

            <CollectionView x:Name="ProductsListView" 
                            HeightRequest="200"
                            SelectionMode="Single"
                            SelectionChanged="OnProductSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10">
                            <Label Text="{Binding Name}" TextColor="Black" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="LightGray" />

            <Entry x:Name="ProductNameEntry" Placeholder="Product Name" TextColor="Black" />
            <Entry x:Name="ProductDescEntry" Placeholder="Description" TextColor="Black" />
            <Entry x:Name="ProductPriceEntry" Placeholder="Price" Keyboard="Numeric" TextColor="Black" />
            <Entry x:Name="ProductCategoryEntry" Placeholder="Category" TextColor="Black" />

            <Label Text="Product Image" TextColor="{StaticResource Black}" />
            <Grid ColumnDefinitions="Auto,*, Auto" ColumnSpacing="10">
                <Entry x:Name="ProductImageEntry"
                       Grid.Column="0"
                       Placeholder="Image filename"
                       TextColor="{StaticResource Black}"
                       IsReadOnly="True"/>
                <Button Grid.Column="1" 
                        Text="Pick Image" 
                        Clicked="OnPickImageClicked" 
                        BackgroundColor="#007ACC" 
                        TextColor="White" />
            </Grid>

            <Image x:Name="ProductImagePreview" 
                   HeightRequest="150" 
                   Aspect="AspectFit" 
                   IsVisible="False" 
                   Margin="0,10"/>


            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Create" 
                        BackgroundColor="Green" TextColor="White"
                        Clicked="OnCreateProductClicked"/>
                <Button Grid.Column="1" Text="Update" 
                        BackgroundColor="Blue" TextColor="White"
                        Clicked="OnUpdateProductClicked"/>
                <Button Grid.Column="2" Text="Delete" 
                        BackgroundColor="Red" TextColor="White"
                        Clicked="OnDeleteProductClicked"/>
            </Grid>

            <Button Text="Go To StyleHub" Clicked="OnBackToStoreClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>