<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoreApp.src.Views.OrderHistoryPage"
             Title="Order History">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Your Past Orders" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>

            <CollectionView x:Name="OrdersCollectionView" ItemsSource="{Binding UserOrders}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="15" BorderColor="#D1D1D1" CornerRadius="8">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                    <Label Text="{Binding OrderDate, StringFormat='Date: {0:MMMM dd, yyyy}'}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Status, StringFormat='Status: {0}'}" TextColor="DarkGreen"/>
                                </VerticalStackLayout>
                                
                                <Label Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding TotalAmount, StringFormat='{0:C}'}" 
                                       FontSize="18" VerticalOptions="Center"/>
                                
                                <Label Grid.Row="1" Grid.Column="0" 
                                       Text="{Binding OrderId, StringFormat='Order ID: #{0}'}" 
                                       FontSize="12" TextColor="Gray"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>