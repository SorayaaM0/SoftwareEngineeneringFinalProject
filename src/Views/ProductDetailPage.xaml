<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoreApp.Views.ProductDetailPage"
             Background="{StaticResource BackgroundGradient}"
             NavigationPage.HasNavigationBar="False">
    <Grid>
        <Grid RowDefinitions="Auto, *">

            <!-- Navbar -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto, *, Auto"
                  BackgroundColor="{StaticResource Background}"
                  Padding="20,15">

                <Image Grid.Column="0"
                       Source="stylehub.png"
                       HeightRequest="36"
                       WidthRequest="120"
                       Aspect="AspectFit"
                       VerticalOptions="Center"/>

                <Button Grid.Column="2"
                        Text="☰" FontSize="22"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource White}"
                        HeightRequest="40" WidthRequest="40"
                        CornerRadius="8"
                        Clicked="OnMenuClicked">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="TextColor" Value="{StaticResource Secondary}"/>
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                </Button>
            </Grid>

            <!-- All scrollable content in Row 1 -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="0">

                    <!-- Product detail section -->
                    <Grid ColumnDefinitions="0.45*, 0.55*"
                          Padding="20"
                          ColumnSpacing="24">

                        <!-- LEFT — Product image card -->
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource White}"
                                StrokeShape="RoundRectangle 24"
                                StrokeThickness="0"
                                Padding="16"
                                VerticalOptions="Start"
                                Margin="0,10,0,0">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource Black}"
                                        Offset="0,15"
                                        Radius="30"
                                        Opacity="0.60"/>
                            </Border.Shadow>
                            <Image x:Name="ProductImage"
                                   Aspect="AspectFit"
                                   HeightRequest="340"
                                   HorizontalOptions="Fill"/>
                        </Border>
                        

                        <!-- RIGHT — Product info -->
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="20"
                                             Padding="0,10,0,20">

                            <!-- Category tag -->
                            <Border BackgroundColor="Transparent"
                                    StrokeShape="RoundRectangle 20"
                                    Stroke="{StaticResource Secondary}"
                                    StrokeThickness="1"
                                    Padding="10,4"
                                    HorizontalOptions="Start">
                                <Label x:Name="ProductCategory"
                                       Text="CATEGORY"
                                       FontSize="11"
                                       TextColor="{StaticResource Secondary}"
                                       CharacterSpacing="1.5"/>
                            </Border>

                            <!-- Product name -->
                            <Label x:Name="ProductName"
                                   Text="Product Name"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   LineBreakMode="WordWrap"/>

                            <!-- Description -->
                            <Label x:Name="ProductDescription"
                                   Text="Product description goes here."
                                   FontSize="14"
                                   TextColor="{StaticResource Gray400}"
                                   LineBreakMode="WordWrap"
                                   LineHeight="1.5"/>

                            <BoxView HeightRequest="1" Color="{StaticResource Gray600}"/>

                            <!-- Size options -->
                            <VerticalStackLayout Spacing="10">
                                <Label Text="SELECT SIZE"
                                       FontSize="11"
                                       TextColor="{StaticResource Gray400}"
                                       CharacterSpacing="2"/>
                                <HorizontalStackLayout x:Name="SizeContainer" Spacing="10">
                                    <Button Text="XS" Clicked="OnSizeSelected"
                                            BackgroundColor="Transparent" TextColor="White"
                                            BorderColor="#555" BorderWidth="1"
                                            CornerRadius="8" HeightRequest="40" WidthRequest="50"/>
                                    <Button Text="S" Clicked="OnSizeSelected"
                                            BackgroundColor="Transparent" TextColor="White"
                                            BorderColor="#555" BorderWidth="1"
                                            CornerRadius="8" HeightRequest="40" WidthRequest="50"/>
                                    <Button Text="M" Clicked="OnSizeSelected"
                                            BackgroundColor="Transparent" TextColor="White"
                                            BorderColor="#555" BorderWidth="1"
                                            CornerRadius="8" HeightRequest="40" WidthRequest="50"/>
                                    <Button Text="L" Clicked="OnSizeSelected"
                                            BackgroundColor="Transparent" TextColor="White"
                                            BorderColor="#555" BorderWidth="1"
                                            CornerRadius="8" HeightRequest="40" WidthRequest="50"/>
                                    <Button Text="XL" Clicked="OnSizeSelected"
                                            BackgroundColor="Transparent" TextColor="White"
                                            BorderColor="#555" BorderWidth="1"
                                            CornerRadius="8" HeightRequest="40" WidthRequest="50"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{StaticResource Gray600}"/>

                            <!-- Price + Buttons -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                                <VerticalStackLayout Grid.Column="0" Spacing="10">
                                    <Button x:Name="WishlistButton"
                                            Text="♡  Save for Later"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Secondary}"
                                            BorderColor="{StaticResource Secondary}"
                                            BorderWidth="1"
                                            CornerRadius="8"
                                            HeightRequest="46"
                                            Clicked="OnWishlistClicked"/>
                                    <Button Text="Add to Cart"
                                            BackgroundColor="{StaticResource Primary}"
                                            TextColor="White"
                                            CornerRadius="8"
                                            HeightRequest="46"
                                            Clicked="OnAddToCartClicked">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroupList>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal"/>
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor" Value="{StaticResource Secondary}"/>
                                                            <Setter Property="TextColor" Value="Black"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateGroupList>
                                        </VisualStateManager.VisualStateGroups>
                                    </Button>
                                    
                                    <Button Text="🚩 Report Product"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Danger}"
                                            BorderColor="{StaticResource Danger}"
                                            BorderWidth="1"
                                            CornerRadius="8"
                                            HeightRequest="36"
                                            FontSize="12"
                                            Clicked="OnReportProductClicked"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     HorizontalOptions="End"
                                                     Spacing="4">
                                    <Label Text="PRICE"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray400}"
                                           CharacterSpacing="1.5"
                                           HorizontalOptions="End"/>
                                    <Label x:Name="ProductPrice"
                                           Text="$0.00"
                                           FontSize="28"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Secondary}"
                                           HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Grid>

                        </VerticalStackLayout>
                    </Grid>

                    <!-- Similar Products header bar — full width -->
                    <Grid BackgroundColor="{StaticResource Surface}"
                          Padding="20,14"
                          Margin="0,20,0,0">
                        <Grid ColumnDefinitions="4, *">
                            <BoxView Grid.Column="0"
                                     BackgroundColor="{StaticResource Secondary}"/>
                            <Label Grid.Column="1"
                                   x:Name="SimilarProductsLabel"
                                   Text="Similar Products"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   Margin="16,0"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Grid>

                    <!-- Similar Products cards -->
                    <VerticalStackLayout Padding="20,16">
                        <CollectionView x:Name="SimilarProductsCollection"
                                        HeightRequest="420"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource White}"
                                           WidthRequest="200"
                                           StrokeShape="RoundRectangle 15"
                                           Padding="0">
                                        <Border.Shadow>
                                            <Shadow Brush="{StaticResource Black}"
                                                    Offset="0,10"
                                                    Radius="25"
                                                    Opacity="0.50"/>
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Tapped="OnSimilarProductTapped"
                                                CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Grid>
                                            <VerticalStackLayout>
                                                <Image Source="{Binding ImageUrl}"
                                                       HeightRequest="160"
                                                       Aspect="AspectFit"
                                                       BackgroundColor="#FDFDFD"/>
                                                <VerticalStackLayout Padding="12">
                                                    <Label Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="Black"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1"/>
                                                    <Label Text="{Binding Category}"
                                                           FontSize="11"
                                                           TextColor="{StaticResource Gray400}"
                                                           Margin="0,2"/>
                                                    <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                                                           FontSize="16"
                                                           TextColor="Black"
                                                           FontAttributes="Bold"
                                                           Margin="0,4,0,0"/>
                                                    <Button Text="Add to Cart"
                                                            Clicked="OnSimilarAddToCartClicked"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="Black"
                                                            TextColor="White"
                                                            CornerRadius="8"
                                                            FontSize="12"
                                                            HeightRequest="36"
                                                            Margin="0,8,0,0"/>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

        <!-- Sidebar overlay -->
        <BoxView x:Name="SidebarOverlay"
                 Color="Black" Opacity="0"
                 IsVisible="False"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Sidebar panel -->
        <Grid x:Name="SidebarPanel"
              WidthRequest="300"
              HorizontalOptions="End"
              BackgroundColor="{StaticResource Surface}"
              TranslationX="300">
            <ScrollView>
                <VerticalStackLayout Padding="24" Spacing="8">
                    <Button Text="✕" HorizontalOptions="End"
                            BackgroundColor="Transparent" TextColor="White"
                            FontSize="18" Clicked="OnCloseSidebarClicked"
                            Margin="0,0,0,20"/>
                    <Label x:Name="SidebarUserLabel" Text="Welcome"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="White" Margin="0,0,0,4"/>
                    <Label x:Name="SidebarEmailLabel" Text=""
                           FontSize="12" TextColor="{StaticResource Gray400}"
                           Margin="0,0,0,20"/>
                    <BoxView HeightRequest="1" Color="{StaticResource Gray600}" Margin="0,0,0,20"/>
                    <Button Text="🏠  Home" Style="{StaticResource SidebarButton}" Clicked="OnHomeClicked"/>
                    <Button Text="👤  My Account" Style="{StaticResource SidebarButton}" Clicked="OnAccountClicked"/>
                    <Button Text="🛒  Cart" Style="{StaticResource SidebarButton}" Clicked="OnCartClicked"/>
                    <Button Text="♡  Collections" Style="{StaticResource SidebarButton}" Clicked="OnCollectionsClicked"/>
                    <BoxView HeightRequest="1" Color="{StaticResource Gray600}" Margin="0,10"/>
                    <Button x:Name="SidebarLoginBtn" Text="Login / Register"
                            Style="{StaticResource SidebarButton}" Clicked="OnAccountClicked"/>
                    <Button x:Name="SidebarLogoutBtn" Text="🚪  Logout"
                            IsVisible="False" BackgroundColor="Transparent"
                            TextColor="{StaticResource Danger}"
                            HorizontalOptions="Start"
                            Clicked="OnSidebarLogoutClicked"/>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

    </Grid>
</ContentPage>