<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoreApp.Views.AccountPage"
             Title="AccountPage"
             Background="White">
    <VerticalStackLayout Spacing="10">
        <HorizontalStackLayout Padding="20" Spacing="15">
            <Image Source="user_placeholder.png" WidthRequest="80" HeightRequest="80" Aspect="AspectFill" VerticalOptions="Center"/>
            <VerticalStackLayout VerticalOptions="Center">
                <Label x:Name="UserNameLabel" FontSize="20" FontAttributes="Bold" />
                <Label x:Name="UserEmailLabel" FontSize="14" TextColor="#555555"/>
            </VerticalStackLayout>
        </HorizontalStackLayout>
        <!--Account options-->
        <Button Text="Log Out" BackgroundColor="Black" TextColor="White" Clicked="OnLogoutClicked" />
    </VerticalStackLayout>
</ContentPage>