<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoreApp.Views.AdminPage"
             Title="AdminPage">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Admin Panel"
           FontSize="24"
           FontAttributes="Bold" />

        <Button Text="Moderate Listings"
            Clicked="OnModerateListingsClicked" />

        <Button Text="Manage Sellers"
            Clicked="OnManageUsersClicked" />

        <Button Text="View Security Logs"
            Clicked="OnUnauthorizedAccessClicked" />

        <Button Text="Back To Stylehub"
                Clicked="OnBackClicked"/>
    </VerticalStackLayout>
</ContentPage>