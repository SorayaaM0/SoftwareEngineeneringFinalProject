<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoreApp.Views.RegisterPage"
             Title="RegisterPage"
             BackgroundColor="White">
    <VerticalStackLayout Padding="30" Spacing="15">

        <Entry x:Name="NameEntry"
               Placeholder="Full Name"
               TextColor="Black"/>

        <Entry x:Name="EmailEntry"
               Placeholder="Email"
               Keyboard="Email"
               TextColor="Black"/>

        <Entry x:Name="PasswordEntry"
               Placeholder="Password"
               IsPassword="True"
               TextColor="Black"/>

        <Entry x:Name="ConfirmPasswordEntry"
               Placeholder="Confirm Password"
               IsPassword="True"
               TextColor="Black"/>

        <HorizontalStackLayout Spacing="10">
            <CheckBox x:Name="IsSellerCheckBox" Color="Blue" VerticalOptions="Center" />
            <Label Text="Register as a Seller?" VerticalOptions="Center" TextColor="Black" />
        </HorizontalStackLayout>

        <Entry x:Name="StoreNameEntry" 
               Placeholder="Store Name (Sellers Only)" 
               TextColor="Black" />


        <Button Text="Create Account"
                Clicked="OnRegisterClicked"/>

    </VerticalStackLayout>
</ContentPage>