<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoreApp.Views.RegisterPage"
             Background ="{StaticResource BackgroundGradient}">
    <Grid>
        <Border WidthRequest="800"
                HeightRequest="600"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{StaticResource Surface}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="0"
                Margin="20">
            <Border.Shadow>
                <Shadow Brush="Black"
                        Offset="0,25"
                        Radius="60"
                        Opacity="0.80"/>
                
            </Border.Shadow>
            <!--Register Form-->
            <Grid ColumnDefinitions="*,*">
                <VerticalStackLayout Grid.Column="0"
                                     Padding="20"
                                     Spacing="15"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Margin="1,1,1,1">
                    <Label Text="Find Your Style Today!"
                           TextColor="{StaticResource Black}"
                           FontSize="20"
                           FontAttributes="Bold"/>
                    <Entry x:Name="NameEntry"
                           Placeholder="Enter First and Last"
                           TextColor="{StaticResource Black}"/>
                    <Entry x:Name="EmailEntry"
                           Placeholder="Enter Email"
                           Keyboard="Email"
                           TextColor="{StaticResource Black}"/>
                    <Entry x:Name="PasswordEntry"
                           Placeholder="Enter Password"
                           IsPassword="True"
                           TextColor="{StaticResource Black}"/>
                    <Entry x:Name="ConfirmPasswordEntry"
                           Placeholder="Confirm Password"
                           IsPassword="True"
                           TextColor="{StaticResource Black}"/>

                    <HorizontalStackLayout Spacing="10"
                                           Padding="5"
                                           Margin="0,10,0,10">
                        <VerticalStackLayout>
                            <Label Text="Seller?"/>
                            <CheckBox x:Name="IsSellerCheckBox"/>
                        </VerticalStackLayout>
                        <Entry x:Name="StoreNameEntry"
                               Placeholder="Store Name Here..."
                               IsVisible="{Binding Source={x:Reference IsSellerCheckBox},Path=IsChecked}"/>

                    </HorizontalStackLayout>

                    <Button Text="Register"
                            TextColor="{StaticResource Black}"
                            BackgroundColor="{StaticResource Primary}"
                            Clicked="OnRegisterClicked"/>
                </VerticalStackLayout>

                <Image Grid.Column="1"
                       Source="quietstreet.jpg"
                       Aspect="AspectFill"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>