<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyStoreApp.Views.ProductPage"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto, *">
        
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto" Padding="20,15" ColumnSpacing="15" BackgroundColor="#F8F9FA">
            <Label Grid.Column="0" Text="StyleHub" FontSize="20" TextColor="Purple" FontAttributes="Bold" VerticalOptions="Center"/>
            <Frame Grid.Column="1" BackgroundColor="White" CornerRadius="10" Padding="10,0" HasShadow="False" BorderColor="#E0E0E0">
                <Entry x:Name="ProductSearchEntry" Placeholder="Search products..." TextColor="Black" FontSize="13" HeightRequest="40" TextChanged="OnSearchTextChanged"/>
            </Frame>
            <Button Grid.Column="2" Text="Collections" FontAttributes="Bold" TextColor="#555555" BackgroundColor="Transparent" Clicked="OnCollectionsClicked" />
            <Button Grid.Column="3" Text="🛒" BackgroundColor="White" TextColor="Black" BorderColor="#E0E0E0" BorderWidth="1" HeightRequest="40" WidthRequest="40" CornerRadius="8" Clicked="OnCartClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20">
                
                <HorizontalStackLayout Spacing="20" Margin="0,0,0,20">
                    
                    <Button x:Name="CategoryBtn"
                            Text="Select Category"
                            WidthRequest="180"
                            BackgroundColor="White"
                            TextColor="Black"
                            BorderColor="#E0E0E0"
                            BorderWidth="1">
                        <FlyoutBase.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="All" Clicked="OnCategorySelected" CommandParameter="All" />
                                <MenuFlyoutItem Text="Tops" Clicked="OnCategorySelected" CommandParameter="TOPS" />
                                <MenuFlyoutItem Text="Bottoms" Clicked="OnCategorySelected" CommandParameter="BOTTOMS" />
                                <MenuFlyoutItem Text="Outerwear" Clicked="OnCategorySelected" CommandParameter="OUTERWEAR" />
                                <MenuFlyoutItem Text="Dresses" Clicked="OnCategorySelected" CommandParameter="DRESSES" />
                            </MenuFlyout>
                        </FlyoutBase.ContextFlyout>
                    </Button>

                    <Button x:Name="SortBtn"
                            Text="Sort By Price"
                            WidthRequest="180"
                            BackgroundColor="White"
                            TextColor="Black"
                            BorderColor="#E0E0E0"
                            BorderWidth="1">
                        <FlyoutBase.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Low to High" Clicked="OnSortSelected" CommandParameter="LowToHigh" />
                                <MenuFlyoutItem Text="High to Low" Clicked="OnSortSelected" CommandParameter="HighToLow" />
                            </MenuFlyout>
                        </FlyoutBase.ContextFlyout>
                    </Button>
                </HorizontalStackLayout>

                <Label Text="All Products" FontSize="28" FontAttributes="Bold" TextColor="Black"/>
                <Label Text="The latest arrivals this season" FontSize="14" TextColor="#666666" Margin="0,0,0,25"/>

                <CollectionView x:Name="ProductsCollection" HeightRequest="460">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="White" WidthRequest="215" CornerRadius="12" HasShadow="False" BorderColor="#EEEEEE" Padding="0">
                                
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter TargetName="ProductDescription" Property="Label.Opacity" Value="1" />
                                                <Setter Property="BackgroundColor" Value="#F9F9F9" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid>
                                    <VerticalStackLayout>
                                        <Image Source="{Binding imageUrl}" HeightRequest="180" Aspect="AspectFit" BackgroundColor="#FDFDFD"/>
                                        <VerticalStackLayout Padding="15">
                                            <Label Text="{Binding name}" FontSize="15" FontAttributes="Bold" TextColor="#333333"/>
                                            
                                            <Label x:Name="ProductDescription" 
                                                   Text="{Binding description}" 
                                                   FontSize="12" 
                                                   TextColor="#666666" 
                                                   Opacity="0" 
                                                   MaxLines="2" 
                                                   LineBreakMode="TailTruncation"
                                                   Margin="0,5"/>

                                            <Label Text="{Binding price, StringFormat='${0:F2}'}" FontSize="17" TextColor="Black" FontAttributes="Bold"/>
                                            <Button Text="Add to Cart" Clicked="OnAddToCartClicked" CommandParameter="{Binding .}" BackgroundColor="Black" TextColor="White" CornerRadius="8" Margin="0,10,0,0"/>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                    
                                    <Button Text="♡" Clicked="OnWishlistClicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="Red" FontSize="22" HorizontalOptions="End" VerticalOptions="Start" Padding="10"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>