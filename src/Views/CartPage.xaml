<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoreApp.Views.CartPage"
             BackgroundColor="{StaticResource Background}">

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto,Auto">

            <!-- Title -->
            <Label Grid.Row="0"
           Text="{Binding Name, StringFormat='{}{0}s Cart'}"
           FontSize="24"
           FontAttributes="Bold"
           TextColor="{StaticResource Black}"    
           HorizontalOptions="Center"/>

            <!-- Cart List -->
            <Frame Grid.Row="1"
           Margin="20"
           BackgroundColor="#F5F5F5"
           CornerRadius="10"
           HasShadow="True">

                

                <CollectionView x:Name="CartCollection" EmptyView="Your cart is empty!">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10" ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCartItemTapped"
                                                          CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                                <Image Source="{Binding ImageUrl}" WidthRequest="80" HeightRequest="80"/>

                                <VerticalStackLayout Grid.Column="1" Margin="15,0">
                                    <Label Text="{Binding Name}" TextColor="{StaticResource Black}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Price, StringFormat='${0:F2}'}" TextColor="{StaticResource Black}"/>
                                    <Label Text="{Binding Quantity}" TextColor="{StaticResource Black}" FontSize="16" VerticalOptions="Center"/>
                                </VerticalStackLayout>

                                <Button Grid.Column="2"
                                        Text="-"
                                        Clicked="OnDecreaseQuantity"
                                        CommandParameter="{Binding .}"
                                        TextColor="{StaticResource Danger}"/>

                                <Button Grid.Column="3"
                                        Text="+"
                                        Clicked="OnIncreaseQuantity"
                                        CommandParameter="{Binding .}"
                                        TextColor="{StaticResource Primary}"
                                        Padding="10"/>       

                                <!-- Remove Button -->
                                <Button Grid.Column="4"
                                Text="Remove"
                                Clicked="OnRemoveClicked"
                                CommandParameter="{Binding .}"
                                BackgroundColor="{StaticResource Danger}"
                                TextColor="White"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <!-- Total -->
            <Label Grid.Row="2"
           x:Name="TotalLabel"
           FontSize="18"
           FontAttributes="Bold"
           HorizontalOptions="End"
           Margin="20,10"/>

            <!-- Checkout -->
            <Button Grid.Row="3"
            Text="Proceed to Checkout"
            BackgroundColor="Green"
            TextColor="White"
            HeightRequest="50"
            Margin="20"
            Clicked="OnCheckoutClicked"/>
        </Grid>
    </Grid>
</ContentPage>